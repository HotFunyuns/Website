{
  "name": "reign-creative-llc-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Reign Creative LLC — mobile apps and digital products",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/audit-catalog.mjs && next build && node scripts/validate-content.mjs && node scripts/audit-authorship.mjs && node scripts/postbuild-normalize-urls.mjs",
    "test": "node scripts/tests/run.mjs",
    "queue:status": "node scripts/publish-queue.mjs status",
    "queue:release": "node scripts/publish-queue.mjs release",
    "queue:report": "node scripts/publish-queue.mjs report",
    "links:after-publish": "node scripts/post-publication-links.mjs",
    "audit:authorship": "node scripts/audit-authorship.mjs",
    "audit:entities": "node scripts/audit-entities.mjs",
    "report:search-console": "node scripts/search-console-refresh.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "build:only": "next build",
    "postbuild:urls": "node scripts/postbuild-normalize-urls.mjs",
    "start": "next start",
    "lint": "next lint",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "keywords": "node scripts/build-keyword-map.mjs",
    "report:links": "node scripts/link-report.mjs",
    "audit:output": "node scripts/audit-output.mjs",
    "audit:analytics": "node scripts/audit-analytics.mjs",
    "audit:schema": "node scripts/validate-structured-data.mjs",
    "audit:content": "node scripts/preflight-articles.mjs",
    "audit:sources": "node scripts/check-sources.mjs --bodies",
    "audit:canonicals": "node scripts/audit-canonicals.mjs",
    "audit:redirects": "node scripts/audit-redirects.mjs",
    "audit:duplicates": "node scripts/audit-duplicate-content.mjs",
    "audit:feeds": "node scripts/validate-sitemap-rss.mjs",
    "audit:urls": "npm run audit:canonicals && npm run audit:redirects && npm run audit:duplicates && npm run audit:backnav",
    "verify:play": "node scripts/verify-play-listings.mjs",
    "research:intent": "node scripts/collect-search-intent.mjs",
    "audit:all": "npm run audit:content && npm run audit:catalog && npm run audit:output && npm run audit:schema && npm run audit:analytics && npm run audit:authorship && npm run audit:entities && npm run report:links && npm run audit:urls && npm run audit:feeds && npm test",
    "audit:backnav": "node scripts/audit-back-navigation.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "github-slugger": "^2.0.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
